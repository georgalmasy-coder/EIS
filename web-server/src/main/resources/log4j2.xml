<?xml version="1.0" encoding="UTF-8"?>
<Configuration status="WARN" monitorInterval="60">
    <Properties>
        <!-- Change these as needed -->
        <Property name="appName">EIS</Property>
        <Property name="logDir">C:/Logs/web-server</Property>

        <!-- Read log level from system property if provided, otherwise INFO -->
        <Property name="rootLevel">${sys:LOG_LEVEL:-INFO}</Property>

        <!-- Pattern with useful web-app context details -->
        <Property name="pattern">%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%t] %c{1.} - %msg%n%throwable</Property>
    </Properties>

    <Appenders>

        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout pattern="${pattern}"/>
        </Console>

        <RollingFile name="RollingFile"
                     fileName="${logDir}/${appName}.log"
                     filePattern="${logDir}/${appName}-%d{yyyy-MM-dd}-%i.log.gz">
            <PatternLayout pattern="${pattern}"/>

            <!-- Rotate daily and also when file reaches 10 MB -->
            <Policies>
                <TimeBasedTriggeringPolicy interval="1" modulate="true"/>
                <SizeBasedTriggeringPolicy size="10MB"/>
            </Policies>

            <!-- Keep up to 14 compressed log files -->
            <DefaultRolloverStrategy max="14"/>
        </RollingFile>

    </Appenders>

    <Loggers>
        <!-- Reduce noise from common libraries (adjust as desired) -->
        <Logger name="org.apache" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <Logger name="com.microsoft.sqlserver" level="WARN" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <!-- Your application packages (set to DEBUG when troubleshooting) -->
        <Logger name="com.bepa.eis.server" level="DEBUG" additivity="false">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Logger>

        <Root level="${rootLevel}">
            <AppenderRef ref="Console"/>
            <AppenderRef ref="RollingFile"/>
        </Root>
    </Loggers>
</Configuration>