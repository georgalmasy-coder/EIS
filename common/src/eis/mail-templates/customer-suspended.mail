Subject: Account suspended for {{customerName}}
Content-Type: text/html; charset=UTF-8

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Account suspended</title>
</head>
<body style="margin:0;padding:0;background-color:#f4f6f8;font-family:Arial,Helvetica,sans-serif;color:#1f2933;">
<table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="background-color:#f4f6f8;margin:0;padding:24px 0;">
    <tr>
        <td align="center">
            <table role="presentation" width="640" cellspacing="0" cellpadding="0" style="width:640px;max-width:100%;background-color:#ffffff;border-radius:8px;overflow:hidden;border:1px solid #d9e2ec;">
                <tr>
                    <td style="padding:24px 32px;background-color:#9b1c1c;color:#ffffff;">
                        <h1 style="margin:0;font-size:22px;line-height:1.3;font-weight:700;">Account suspended</h1>
                    </td>
                </tr>

                <tr>
                    <td style="padding:32px;">
                        <p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;">
                            Hello {{customerContactName}},
                        </p>

                        <p style="margin:0 0 16px 0;font-size:16px;line-height:1.5;">
                            The account for <strong>{{customerName}}</strong> has been suspended.
                        </p>

                        <p style="margin:0 0 20px 0;font-size:16px;line-height:1.5;">
                            Users connected to this customer account may no longer be able to sign in to {{applicationName}}.
                        </p>

                        <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="margin:20px 0;border-collapse:collapse;border:1px solid #d9e2ec;">
                            <tr>
                                <td style="padding:12px 16px;background-color:#f8fafc;border-bottom:1px solid #d9e2ec;font-size:14px;font-weight:700;">
                                    Suspension details
                                </td>
                            </tr>
                            <tr>
                                <td style="padding:16px;font-size:14px;line-height:1.6;">
                                    <strong>Customer:</strong> {{customerName}}<br>
                                    <strong>Suspended at:</strong> {{suspendedAt}}<br>
                                    <strong>Reason:</strong> {{suspensionReason}}<br>
                                    <strong>Subscription status:</strong> {{subscriptionStatus}}<br>
                                    <strong>Payment status:</strong> {{paymentStatus}}
                                </td>
                            </tr>
                        </table>

                        <p style="margin:0 0 20px 0;font-size:16px;line-height:1.5;">
                            To restore access, please complete the required action below.
                        </p>

                        <table role="presentation" cellspacing="0" cellpadding="0" style="margin:24px 0;">
                            <tr>
                                <td style="border-radius:6px;background-color:#0b69a3;">
                                    <a href="{{reactivationLink}}"
                                       style="display:inline-block;padding:14px 22px;font-size:16px;line-height:1.2;color:#ffffff;text-decoration:none;font-weight:700;border-radius:6px;">
                                        Restore access
                                    </a>
                                </td>
                            </tr>
                        </table>

                        <p style="margin:0 0 16px 0;font-size:14px;line-height:1.5;color:#52606d;">
                            If the button does not work, copy and paste this link into your browser:
                        </p>

                        <p style="margin:0 0 20px 0;font-size:14px;line-height:1.5;word-break:break-all;">
                            <a href="{{reactivationLink}}" style="color:#0b69a3;text-decoration:underline;">{{reactivationLink}}</a>
                        </p>

                        <p style="margin:20px 0 0 0;font-size:14px;line-height:1.5;color:#52606d;">
                            If you believe this suspension is incorrect, please contact support.
                        </p>
                    </td>
                </tr>

                <tr>
                    <td style="padding:20px 32px;background-color:#f8fafc;border-top:1px solid #d9e2ec;">
                        <p style="margin:0;font-size:12px;line-height:1.5;color:#7b8794;">
                            This email was sent automatically by {{applicationName}}. Please do not reply to this email.
                        </p>
                        <p style="margin:8px 0 0 0;font-size:12px;line-height:1.5;color:#7b8794;">
                            Customer ID: {{customerId}} · Workflow ID: {{workflowId}}
                        </p>
                    </td>
                </tr>
            </table>
        </td>
    </tr>
</table>
</body>
</html>